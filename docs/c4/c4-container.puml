@startuml
title <size:24>Container View: biz.dfch.BpmnMcp</size>
<size:24>Container diagram of biz.dfch.BpmnMcp. Stage 1 target: an AI coding agent and a human user interact with the MCP server process; the .bpmn process files under docs/prc/ are the source of truth. Elements marked (Stage 2, deferred) show the anticipated live-canvas evolution.</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>

Person(AICodingAgent, "AI Coding Agent", $descr="An AI agent running in any MCP-compatible host (OpenCode, Claude Desktop, Cursor, ...). Creates and changes BPMN 2.0 diagrams by calling the MCP server's tools.", $tags="", $link="")
Person(HumanUser, "Human User", $descr="The developer. Opens the browser preview to view a diagram after an agent-driven change, and may edit the .bpmn process files directly, out of band.", $tags="", $link="")

System_Boundary("bizdfchBpmnMcp_boundary", "biz.dfch.BpmnMcp", $tags="") {
  Container(bizdfchBpmnMcp.MCPServer, "MCP Server", $techn="Node.js 24, TypeScript, @modelcontextprotocol/sdk, bpmn-moddle, bpmnlint, bpmn-js, pino", $descr="The single Stage 1 process (apps/mcp-server, started as node dist/index.js). Exposes seven MCP tools (create, change, import, export, validate, parse, preview) and two MCP resources (version, config) over stdio. Contains the prc artifact core (bpmn-moddle parse/serialize, the docs/prc/ directory scan as process inventory, in-memory moddle-tree cache with SHA-256 conditional re-read), bpmnlint validation (.bpmnlintrc, bpmnlint:recommended), and the in-process localhost:8080 HTTP preview endpoint serving the bpmn-js Viewer page. In Stage 2 it also acts as the thin MCP client that drives the canvas server. Logs structured JSON lines to logs/ and stderr; never writes to stdout.", $tags="", $link="")
  Container(bizdfchBpmnMcp.BPMNProcessFiles, "BPMN Process Files", $techn="Filesystem, BPMN 2.0 XML", $descr="The committed docs/prc/ directory: one .bpmn file per process, named prc-<uuid>-<slug>.bpmn. The file on disk is the single source of truth for each process; the directory listing is the process inventory (no registry file).", $tags="", $link="")
  Container(bizdfchBpmnMcp.LogFiles, "Log Files", $techn="Filesystem", $descr="Structured JSON log lines (pino + pino-roll), rolling: daily, seven files kept.", $tags="", $link="")
  Container(bizdfchBpmnMcp.CanvasServerStage2deferred, "Canvas Server (Stage 2, deferred)", $techn="Node.js, REST, WebSocket", $descr="A separate process (apps/canvas-server, the yctimlin/mcp_excalidraw precedent): hosts the web canvas UI and provides REST + WebSocket synchronization for the live, two-way-synced diagram. Not in Stage 1 scope.", $tags="", $link="")
  Container(bizdfchBpmnMcp.WebCanvasStage2deferred, "Web Canvas (Stage 2, deferred)", $techn="bpmn-js Modeler (browser)", $descr="The browser page (apps/web) with the full bpmn-js Modeler (drag/drop, connect, delete; bpmn-js-properties-panel optional) for live human editing. Runs in the user's browser. Not in Stage 1 scope.", $tags="", $link="")
  Container(bizdfchBpmnMcp.BPMNCoreLibraryStage2deferred, "BPMN Core Library (Stage 2, deferred)", $techn="TypeScript library", $descr="The shared operations package (packages/bpmn-core) extracted from the MCP server's prc core so the MCP server and the canvas server reuse one implementation. Not in Stage 1 scope.", $tags="", $link="")
}

Rel(AICodingAgent, bizdfchBpmnMcp.MCPServer, "Creates, changes, imports, exports, validates, and parses BPMN processes and requests previews", $techn="MCP (JSON-RPC) over stdio", $tags="", $link="")
Rel(bizdfchBpmnMcp.MCPServer, bizdfchBpmnMcp.BPMNProcessFiles, "Reads and writes BPMN 2.0 XML: bpmn-moddle parse/serialize, atomic export writes, SHA-256 conditional re-read on every operation", $techn="", $tags="", $link="")
Rel(HumanUser, bizdfchBpmnMcp.MCPServer, "Views a process diagram in the browser after agent-driven changes (turn-based preview)", $techn="HTTP, localhost:8080, bpmn-js Viewer", $tags="", $link="")
Rel(HumanUser, bizdfchBpmnMcp.BPMNProcessFiles, "May edit .bpmn files directly; out-of-band changes are detected by the checksum re-read", $techn="", $tags="", $link="")
Rel(bizdfchBpmnMcp.MCPServer, bizdfchBpmnMcp.LogFiles, "Writes structured JSON log lines (file + stderr dual output)", $techn="", $tags="", $link="")
Rel(bizdfchBpmnMcp.MCPServer, bizdfchBpmnMcp.CanvasServerStage2deferred, "Drives the live canvas (Stage 2, deferred)", $techn="REST + WebSocket", $tags="", $link="")
Rel(bizdfchBpmnMcp.WebCanvasStage2deferred, bizdfchBpmnMcp.CanvasServerStage2deferred, "Loads and live-edits the diagram in the bpmn-js Modeler (Stage 2, deferred)", $techn="HTTP + WebSocket (browser)", $tags="", $link="")
Rel(HumanUser, bizdfchBpmnMcp.WebCanvasStage2deferred, "Live-edits the diagram in the browser (Stage 2, deferred)", $techn="", $tags="", $link="")
Rel(bizdfchBpmnMcp.CanvasServerStage2deferred, bizdfchBpmnMcp.BPMNProcessFiles, "Reads and writes .bpmn files; the file on disk remains the source of truth (Stage 2, deferred)", $techn="", $tags="", $link="")
Rel(bizdfchBpmnMcp.MCPServer, bizdfchBpmnMcp.BPMNCoreLibraryStage2deferred, "Reuses the shared BPMN operations after extraction (Stage 2, deferred)", $techn="", $tags="", $link="")
Rel(bizdfchBpmnMcp.CanvasServerStage2deferred, bizdfchBpmnMcp.BPMNCoreLibraryStage2deferred, "Reuses the shared BPMN operations (Stage 2, deferred)", $techn="", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml
