{
  "name": "biz.dfch.bpmnmcp-workspace",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=apps/mcp-server",
    "lint": "npm run lint --workspace=apps/mcp-server",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspace=apps/mcp-server --",
    "dev": "npm run dev --workspace=apps/mcp-server"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vitest": "^2.1.9"
  }
}
