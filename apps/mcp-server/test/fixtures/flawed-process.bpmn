<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_flawed" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="flawed-process" isExecutable="false">
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="review" name="Review" />
    <bpmn:task id="orphan-task" name="Orphan task" />
    <bpmn:sequenceFlow id="flow-1" sourceRef="start" targetRef="review" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="flawed-process">
      <bpmndi:BPMNShape id="shape-start" bpmnElement="start">
        <dc:Bounds x="152" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape-review" bpmnElement="review">
        <dc:Bounds x="252" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape-orphan" bpmnElement="orphan-task">
        <dc:Bounds x="452" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="edge-flow-1" bpmnElement="flow-1">
        <di:waypoint x="188" y="120" />
        <di:waypoint x="252" y="120" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
