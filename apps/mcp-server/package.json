{
  "name": "biz.dfch.bpmnmcp",
  "version": "0.1.0",
  "description": "A Model Context Protocol (MCP) server for agent-and-human BPMN 2.0 process modeling: create, change, import, export, validate, and parse BPMN diagrams, with a turn-based local browser preview. Free and Open Source Software, runs entirely locally / on-premises over stdio.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "bpmn",
    "bpmn-io"
  ],
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dfch/biz.dfch.BpmnMcp.git"
  },
  "type": "module",
  "bin": {
    "biz.dfch.bpmnmcp": "dist/index.js"
  },
  "engines": {
    "node": ">=26"
  },
  "files": [
    "dist",
    "logging.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "prepack": "node scripts/prepare-publish.mjs",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "bpmn-js": "^18.31.1",
    "bpmn-moddle": "^10.3.1",
    "bpmnlint": "^12.1.0",
    "pino": "^10.4.0",
    "pino-roll": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "ajv": "^8.20.0"
  }
}
