# Local machine overrides for biz.dfch.BpmnMcp (QA 0.0160/0.0170).
# Copy this file to .env and uncomment/edit what you need; a missing
# .env is not an error (REQ-009). Precedence: real environment
# (including .env) > logging.json > built-in defaults.

# --- Logging (REQ-008) ---------------------------------------------
# Rolling log file base path (daily rotation; default: logs/server).
# BPMN_MCP_LOG_FILE=logs/server

# Minimum log level (pino levels: trace, debug, info, warn, error,
# fatal; default: info).
# BPMN_MCP_LOG_LEVEL=info

# Rotation frequency (daily, hourly, or a number of milliseconds;
# default: daily).
# BPMN_MCP_LOG_ROTATE=daily

# How many rotated files to retain in total, active file included
# (default: 7; exact pino-roll limit.count value confirmed by the
# Task 100.165 interop spike).
# BPMN_MCP_LOG_RETAIN=7

# --- Documents root (REQ-010) ---------------------------------------
# Root directory for specmgr-style documents; BPMN processes live
# under its hardcoded "prc" subdirectory (<root>/prc). Default: ./docs
# BPMN_MCP_DOCS_DIR=./docs

# --- OpenTelemetry (disabled unless set; QA 0.0130/0.0170) ----------
# With no endpoint set, the OTel SDK is never initialized and all
# instrumentation stays a no-op - this feature reports the OTel
# endpoint state as "disabled" regardless (out of scope for this
# feature's own instrumentation).
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_PROTOCOL=
# OTEL_SERVICE_NAME=
# OTEL_RESOURCE_ATTRIBUTES=
